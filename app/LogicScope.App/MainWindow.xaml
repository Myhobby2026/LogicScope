<Window x:Class="LogicScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="LogicScope" Width="1440" Height="920" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.InputBindings>
    <KeyBinding Key="Space" Command="{Binding ToggleCaptureCommand}" />
    <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCaptureCommand}" />
    <KeyBinding Modifiers="Control" Key="Z" Command="{Binding ZoomToFitCommand}" />
  </Window.InputBindings>
  <Grid Background="{StaticResource WindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="62" />
      <RowDefinition Height="*" />
      <RowDefinition Height="46" />
      <RowDefinition Height="190" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <!-- Main app header / file actions -->
    <Border Grid.Row="0" Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
      <DockPanel Margin="16,0">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" Background="{StaticResource AccentBrush}" CornerRadius="7" Margin="0,0,10,0">
            <TextBlock Text="LS" Foreground="#07131B" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="LogicScope" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="16-channel logic analyzer" FontSize="10" Foreground="{StaticResource MutedText}" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Open" Command="{Binding OpenCaptureCommand}" />
          <Button Content="Save  Ctrl+S" Command="{Binding SaveCaptureCommand}" />
          <Button Content="CSV" Command="{Binding ExportCsvCommand}" />
          <Button Content="VCD" Command="{Binding ExportVcdCommand}" />
          <Button Content="PulseView .sr" Command="{Binding ExportSigrokCommand}" />
          <Button Content="Saleae .bin" Command="{Binding ExportSaleaeCommand}" />
          <Button Content="SELFTEST 1 MHz" Command="{Binding ToggleSelfTestCommand}"
                  ToolTip="Toggle Teensy PWM outputs on pins 22 and 23; stop acquisition first" />
          <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="10,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Capture control bar -->
    <Border Grid.Row="1" Background="#0E1621" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,7">
        <Button DockPanel.Dock="Left" Content="{Binding CaptureButtonText}" Command="{Binding ToggleCaptureCommand}"
                Background="{StaticResource AccentBrush}" Foreground="#07131B" FontWeight="SemiBold"
                Padding="18,8" Margin="0,0,14,0" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="RATE" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,7,0" />
          <ComboBox Width="118" ItemsSource="{Binding RateChoices}" SelectedItem="{Binding SelectedRate}"
                    DisplayMemberPath="Label" Margin="0,0,14,0" />
          <TextBlock Text="MODE" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,7,0" />
          <ComboBox Width="110" ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding SelectedMode}"
                    DisplayMemberPath="Label" Margin="0,0,14,0" />
          <TextBlock Text="TRIGGER" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,7,0" />
          <ComboBox Width="78" ItemsSource="{Binding TriggerModes}" SelectedItem="{Binding SelectedTriggerMode}"
                    DisplayMemberPath="Label" Margin="0,0,5,0" />
          <ComboBox Width="76" ItemsSource="{Binding TriggerChannels}" SelectedItem="{Binding SelectedTriggerChannel}"
                    DisplayMemberPath="Label" Margin="0,0,5,0" />
          <ComboBox Width="78" ItemsSource="{Binding EdgeChoices}" SelectedItem="{Binding SelectedEdge}"
                    DisplayMemberPath="Label" Margin="0,0,5,0" />
          <TextBox Width="50" Text="{Binding PatternExpression, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Pattern value, hex with X don't-care nibbles" VerticalContentAlignment="Center" Margin="0,0,3,0" />
          <TextBox Width="50" Text="{Binding PatternMaskText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="16-bit pattern mask in hex" VerticalContentAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="PRE %" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox Width="72" ItemsSource="{Binding PreTriggerChoices}" SelectedItem="{Binding SelectedPreTriggerPercent}"
                    Margin="0,0,14,0" />
          <TextBlock Text="DURATION s" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Width="56" Text="{Binding CaptureDurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                   VerticalContentAlignment="Center" Margin="0,0,7,0" />
          <TextBlock Text="0 = continuous" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="10" />
        </StackPanel>
        <Border DockPanel.Dock="Right" Background="{StaticResource PanelRaisedBackground}" CornerRadius="6"
                Padding="10,6" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource AccentBrush}" FontSize="11" />
        </Border>
      </DockPanel>
    </Border>

    <!-- Channel list and virtualized waveform -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="188" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,12,10,9">
            <TextBlock Text="CHANNELS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
            <TextBlock Text="16 digital inputs" FontSize="10" Foreground="#64758C" Margin="0,3,0,0" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Channels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                            Margin="12,4,8,4" Padding="1">
                    <StackPanel Orientation="Horizontal">
                      <Border Width="7" Height="7" CornerRadius="3" Background="{Binding Color}"
                              VerticalAlignment="Center" Margin="0,0,9,0" />
                      <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12" />
                      <TextBlock Text="▰" Foreground="{Binding Color}" FontSize="9" Margin="7,1,0,0" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Background="#0A1018">
        <Grid.RowDefinitions>
          <RowDefinition Height="28" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="#0D1520" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Text="DIGITAL WAVEFORM" Foreground="{StaticResource MutedText}"
                     FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="13,0,0,0" />
          <TextBlock DockPanel.Dock="Right" Text="Wheel: zoom · Drag: pan · Shift-click: cursors · Ctrl+Z: fit"
                     Foreground="#6E8098" FontSize="10" VerticalAlignment="Center" Margin="0,0,13,0" />
        </DockPanel>
        <Border Grid.Row="1" ClipToBounds="True">
          <skia:SKElement x:Name="WaveformSurface" PaintSurface="WaveformSurface_PaintSurface"
                          Focusable="True" />
        </Border>
      </Grid>
    </Grid>

    <!-- Measurements, decoder setup, named buses -->
    <Border Grid.Row="3" Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,1">
      <DockPanel Margin="10,4">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Measure visible" Command="{Binding AnalyzeMeasurementsCommand}" />
          <TextBlock Text="{Binding CursorReadout}" Foreground="{StaticResource AccentBrush}"
                     VerticalAlignment="Center" Margin="10,0,16,0" FontSize="11" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="DECODE" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox Width="136" ItemsSource="{Binding DecoderNames}" SelectedItem="{Binding SelectedDecoderName}" Margin="0,0,5,0" />
          <ComboBox Width="72" ItemsSource="{Binding Channels}" SelectedValuePath="Index"
                    SelectedValue="{Binding DecoderPrimaryChannel}" DisplayMemberPath="Name" Margin="0,0,4,0" />
          <ComboBox Width="72" ItemsSource="{Binding Channels}" SelectedValuePath="Index"
                    SelectedValue="{Binding DecoderSecondaryChannel}" DisplayMemberPath="Name" Margin="0,0,4,0" />
          <ComboBox Width="72" ItemsSource="{Binding Channels}" SelectedValuePath="Index"
                    SelectedValue="{Binding DecoderAuxiliaryChannel}" DisplayMemberPath="Name"
                    ToolTip="SPI MISO / auxiliary channel" Margin="0,0,4,0" />
          <ComboBox Width="72" ItemsSource="{Binding TriggerChannels}"
                    SelectedItem="{Binding SelectedSpiChipSelectChannel}" DisplayMemberPath="Label"
                    ToolTip="SPI chip-select channel (Disabled decodes continuously)" Margin="0,0,4,0" />
          <TextBox Width="78" Text="{Binding DecoderBitRate, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="UART/CAN/Manchester bit rate" VerticalContentAlignment="Center" Margin="0,0,4,0" />
          <ComboBox Width="48" ItemsSource="{Binding UartDataBitChoices}" SelectedItem="{Binding UartDataBits}"
                    ToolTip="UART data bits" Margin="0,0,3,0" />
          <ComboBox Width="66" ItemsSource="{Binding UartParityChoices}" SelectedItem="{Binding SelectedUartParity}"
                    ToolTip="UART parity" Margin="0,0,3,0" />
          <ComboBox Width="48" ItemsSource="{Binding UartStopBitChoices}" SelectedItem="{Binding UartStopBits}"
                    ToolTip="UART stop bits" Margin="0,0,3,0" />
          <CheckBox Content="CPOL" IsChecked="{Binding SpiCpol}" VerticalAlignment="Center" Margin="3,0" />
          <ComboBox Width="46" ItemsSource="{Binding SpiWordBitChoices}" SelectedItem="{Binding SpiWordBits}"
                    ToolTip="SPI word width" Margin="2,0" />
          <CheckBox Content="CPOL" IsChecked="{Binding SpiCpol}" VerticalAlignment="Center" Margin="3,0" />
          <CheckBox Content="CPHA" IsChecked="{Binding SpiCpha}" VerticalAlignment="Center" Margin="3,0" />
          <CheckBox Content="3-wire" IsChecked="{Binding SpiThreeWire}" VerticalAlignment="Center" Margin="3,0" />
          <CheckBox Content="CS low" IsChecked="{Binding SpiChipSelectActiveLow}" VerticalAlignment="Center" Margin="3,0" />
          <CheckBox Content="MSB first" IsChecked="{Binding SpiMsbFirst}" VerticalAlignment="Center" Margin="3,0" />
          <CheckBox Content="Manchester rise=1" IsChecked="{Binding ManchesterRisingIsOne}"
                    VerticalAlignment="Center" Margin="3,0" />
          <Button Content="Decode visible" Command="{Binding DecodeVisibleCommand}" />
          <Button Content="Decoder CSV" Command="{Binding ExportDecoderCsvCommand}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Decode table and measurements/buses -->
    <Grid Grid.Row="4" Margin="10,8,10,7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*" />
        <ColumnDefinition Width="1.2*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1" CornerRadius="7" Margin="0,0,8,0">
        <DockPanel Margin="8">
          <TextBlock DockPanel.Dock="Top" Text="DECODED FRAMES" Foreground="{StaticResource MutedText}"
                     FontSize="10" FontWeight="SemiBold" Margin="4,2,0,7" />
          <DataGrid ItemsSource="{Binding DecodeResults}" AlternationCount="2">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Start" Binding="{Binding StartSample}" Width="100" />
              <DataGridTextColumn Header="End" Binding="{Binding EndSample}" Width="100" />
              <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="100" />
              <DataGridTextColumn Header="Decoded value / annotation" Binding="{Binding Label}" Width="*" />
              <DataGridCheckBoxColumn Header="Error" Binding="{Binding IsError}" Width="60" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1" CornerRadius="7" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0">
            <TextBlock Text="MEASUREMENTS" Foreground="{StaticResource MutedText}" FontSize="10"
                       FontWeight="SemiBold" DockPanel.Dock="Left" />
            <TextBlock Text="BUS GROUPS" Foreground="{StaticResource MutedText}" FontSize="10"
                       FontWeight="SemiBold" DockPanel.Dock="Right" />
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,4">
            <ItemsControl ItemsSource="{Binding MeasurementRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="1,2">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedText}" Width="165" FontSize="10" />
                    <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="10" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBox Width="66" Text="{Binding NewBusName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Bus name" />
            <TextBox Width="92" Text="{Binding NewBusChannels, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="D0-D7 or D0,D2,D5" Margin="4,0" />
            <Button Content="Add bus" Command="{Binding AddBusCommand}" />
            <ItemsControl ItemsSource="{Binding Buses}" Margin="10,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate><Border Background="{StaticResource PanelRaisedBackground}" CornerRadius="4" Padding="6,3" Margin="2,0">
                  <TextBlock Text="{Binding Name}" FontSize="10" />
                </Border></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Status and live rate -->
    <Border Grid.Row="5" Background="#0E1621" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0">
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedText}"
                   FontSize="10" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding CaptureInfoText}" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,16,0" />
          <TextBlock Text="{Binding ThroughputText}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="10" Margin="0,0,16,0" />
          <TextBlock Text="{Binding DropText}" Foreground="#E2A66B" FontSize="10" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
